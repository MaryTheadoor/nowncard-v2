# Cloud Functions environment for NownCard v2 (Square payments).
# Copy to functions/.env for deploy-time params, and functions/.env.local for
# local emulator secrets. Both are gitignored — never commit real values.

# Deploy-time params (read from this file by the Firebase CLI during
# `firebase deploy --only functions`). No secrets here.
SQUARE_ENVIRONMENT=production
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_URL=https://squarewebhook-bms24k7cqa-uc.a.run.app

# Secrets — provisioned in Secret Manager, NOT in .env:
#   firebase functions:secrets:set SQUARE_ACCESS_TOKEN
#   firebase functions:secrets:set SQUARE_WEBHOOK_SIGNATURE_KEY
# For the local emulator only, put them in functions/.env.local.
