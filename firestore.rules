rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(data) {
      return request.auth != null && (
        data.ownerId == request.auth.uid ||
        data.ownerUid == request.auth.uid
      );
    }

    function isReviewOwnerOrAdmin(userId) {
      return request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    function isTeamOwner(data) {
      return request.auth != null && (
        data.teamOwnerId == request.auth.uid ||
        data.teamOwnerUid == request.auth.uid
      );
    }

    // Users: self access; admin full access.
    // Security: self-create cannot set isAdmin or plan (server grants these),
    // self-update cannot touch isAdmin/plan/planUpdatedAt/activeCheckout,
    // and self-delete is blocked (only admins may delete user docs) to close
    // the delete+recreate admin escalation.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['isAdmin'])
        && (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan == 'free');
      allow update: if request.auth != null
        && ((request.auth.uid == uid
             && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'plan', 'planUpdatedAt', 'activeCheckout']))
            || isAdmin());
      allow delete: if request.auth != null && isAdmin();
    }

    // Cards: owners and team owners have control; public readable; admin can read any
    match /cards/{cardId} {
      allow read: if resource.data.isPublic == true || (request.auth != null && isOwner(resource.data)) || (request.auth != null && isTeamOwner(resource.data)) || isAdmin();
      allow create: if request.auth != null && (isOwner(request.resource.data) || isTeamOwner(request.resource.data));
      allow update: if (request.auth != null && (isOwner(resource.data) || isTeamOwner(resource.data) || isAdmin()))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'saveCount']);
      allow delete: if request.auth != null && (isOwner(resource.data) || isTeamOwner(resource.data) || isAdmin());
    }

    // Analytics writes come from the card viewer. Tap counters live under the
    // top-level `taps` map (e.g. taps.flip, taps.save). NOTE: rules `keys()` returns
    // only top-level keys, so the allowlist must contain 'taps' (a previous dotted
    // allowlist like 'taps.flip' silently denied every tap write).
    function isValidAnalyticsKeys() {
      return request.resource.data.keys().hasOnly([
        'viewCount', 'saveCount', 'timeOnPage', 'device', 'referrer', 'updatedAt', 'taps',
      ])
        && (!request.resource.data.keys().hasAny(['device']) || request.resource.data.device is string)
        && (!request.resource.data.keys().hasAny(['referrer']) || request.resource.data.referrer is string)
        && (!request.resource.data.keys().hasAny(['taps']) || (request.resource.data.taps is map && request.resource.data.taps.size() <= 25));
    }

    // Card analytics: writable by anyone (for tap tracking from public cards)
    // Field validation prevents spam documents with arbitrary data
    match /cards/{cardId}/analytics/{eventId} {
      allow read: if request.auth != null && (isOwner(get(/databases/$(database)/documents/cards/$(cardId)).data) || isAdmin());
      allow create, update: if isValidAnalyticsKeys();
      allow delete: if false;
    }

    // NOTE: the legacy publicCards collection is no longer written or read by the
    // app, so its rule block was removed (defaults to deny-all).

    // Analytics (legacy): scoped to card owner/admin; writable by anyone with field validation
    match /analytics/{docId} {
      allow read: if isAdmin() || (request.auth != null && isOwner(get(/databases/$(database)/documents/cards/$(docId)).data));
      allow create, update: if isValidAnalyticsKeys();
      allow delete: if false;
    }

    // Pending upgrades: created ONLY by the server (createCheckout function via
    // Admin SDK). Clients cannot create these — a forged doc with
    // paymentCompleted: true was the payment-bypass vector. Reads are
    // owner/admin (for cancel + admin panel); updates are server/admin only.
    match /pendingUpgrades/{docId} {
      allow create: if false;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Config: readable by anyone (pricing), writable by admin
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Upgrades: server (webhook/callables via Admin SDK) and admins only.
    // Clients cannot fabricate purchase history.
    match /upgrades/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Refunds: audit log written by the Square webhook (Admin SDK); admin-only reads.
    match /refunds/{refundId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Stripe subscriptions (managed by Firebase Extension)
    match /customers/{uid}/subscriptions/{subId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Stripe checkout sessions (managed by Firebase Extension)
    match /customers/{uid}/checkout_sessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
      allow delete: if false;
    }

    // Stripe portal sessions (managed by Firebase Extension)
    match /customers/{uid}/portal_sessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
      allow delete: if false;
    }

    // Messages: authenticated senders only; readable by sender or recipient
    match /messages/{messageId} {
      allow create: if request.auth != null
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && request.resource.data.keys().hasAll(['senderUid', 'recipientUid', 'content', 'cardId', 'cardSlug', 'createdAt']);
      allow read: if request.auth != null
        && (resource.data.recipientUid == request.auth.uid
            || resource.data.senderUid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if request.auth != null
        && (resource.data.recipientUid == request.auth.uid
            || resource.data.senderUid == request.auth.uid);
    }

    function getCardOwnerUid(cardId) {
      return get(/databases/$(database)/documents/cards/$(cardId)).data.ownerUid;
    }

    function getCardOwnerId(cardId) {
      return get(/databases/$(database)/documents/cards/$(cardId)).data.ownerId;
    }

    // Appointments: visitors can request; owners manage; requesters can read their own
    match /appointments/{appointmentId} {
      allow create: if request.resource.data.keys().hasAll([
          'cardId', 'cardSlug', 'ownerUid', 'requesterName', 'requesterEmail',
          'requestedDate', 'requestedTime', 'timezone', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.requesterName.size() > 0
        && request.resource.data.requesterName.size() <= 100
        && request.resource.data.requesterEmail.size() > 0
        && request.resource.data.requesterEmail.size() <= 254
        && request.resource.data.requestedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.requestedTime.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.timezone.size() <= 100
        && (request.resource.data.ownerUid == getCardOwnerUid(request.resource.data.cardId)
            || request.resource.data.ownerUid == getCardOwnerId(request.resource.data.cardId));
      allow read: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid
            || resource.data.requesterEmail == request.auth.token.email
            || isAdmin());
      allow update: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'confirmed', 'cancelled'];
      allow delete: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Reviews: one per user (doc id = user uid); featured readable by anyone
    match /reviews/{userId} {
      allow read: if resource.data.featured == true || isReviewOwnerOrAdmin(userId);
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000
        && request.resource.data.keys().hasAll(['userId', 'rating', 'content', 'featured', 'createdAt'])
        && request.resource.data.featured == false;
      allow delete: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
    }

    // Admin can feature/unfeature reviews via partial update
    match /reviews/{userId} {
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['featured']);
    }
  }
}
