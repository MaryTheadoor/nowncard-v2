# Firebase (already configured in src/lib/firebase.ts)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Payment Provider (Square only — dynamic checkout via createCheckout Cloud Function)
# ---------------------------------------------------------------------------
# Client does NOT need the Square application ID or access token.
# Checkout is created server-side by the createCheckout function, which reads
# pricing from the `config/pricing` Firestore doc.

# ---------------------------------------------------------------------------
# Square (Cloud Functions) — set as Firebase secrets, not in a committed .env
#   firebase functions:secrets:set SQUARE_ACCESS_TOKEN
#   firebase functions:secrets:set SQUARE_WEBHOOK_SIGNATURE_KEY
# Parameters:
#   firebase functions:params:set SQUARE_WEBHOOK_URL=https://us-central1-vcard-studio-314.cloudfunctions.net/squareWebhook
#   firebase functions:params:set SQUARE_LOCATION_ID=...
# For local emulator dev only, copy to functions/.env:
# SQUARE_ACCESS_TOKEN=
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_LOCATION_ID=