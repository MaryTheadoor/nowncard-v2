# Firebase (already configured in src/lib/firebase.ts)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Payment Provider
# ---------------------------------------------------------------------------
# 'square'  = Legacy Square checkout links (manual / state-token flow)
# 'stripe'  = Stripe Checkout via Firebase Extension (auto webhooks + subscriptions)
VITE_PAYMENT_PROVIDER=square

# ---------------------------------------------------------------------------
# Square (legacy — only used when VITE_PAYMENT_PROVIDER=square)
# Get these from https://developer.squareup.com/apps
# Use sandbox credentials for testing, production for live
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ---------------------------------------------------------------------------
# Stripe (only used when VITE_PAYMENT_PROVIDER=stripe)
# ---------------------------------------------------------------------------
# 1. Run: STRIPE_SECRET_KEY=sk_xxx npm run stripe:setup
#    This auto-creates products and populates the Price IDs below.
# 2. Or manually create at https://dashboard.stripe.com/products
VITE_STRIPE_PRICE_PRO=price_xxx
VITE_STRIPE_PRICE_BUSINESS=price_xxx

# 'subscription' = recurring annual billing (recommended)
# 'payment'        = one-time purchase
VITE_STRIPE_CHECKOUT_MODE=subscription
