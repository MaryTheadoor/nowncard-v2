# Firebase (already configured in src/lib/firebase.ts)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Payment Provider (Square only — dynamic checkout via createCheckout Cloud Function)
# ---------------------------------------------------------------------------
# Client does NOT need the Square application ID or access token.
# Checkout is created server-side by the createCheckout function, which reads
# pricing from the `config/pricing` Firestore doc.

# ---------------------------------------------------------------------------
# Square (Cloud Functions) — set as Firebase secrets, not in a committed .env
#   firebase functions:secrets:set SQUARE_ACCESS_TOKEN
#   firebase functions:secrets:set SQUARE_WEBHOOK_SIGNATURE_KEY
# Non-secret params live in functions/.env (read at deploy time by the CLI):
#   SQUARE_ENVIRONMENT=production
#   SQUARE_LOCATION_ID=...
#   SQUARE_WEBHOOK_URL=https://squarewebhook-...uc.a.run.app
# (There is no `functions:params:set` command — .env IS the params source.)
# For local emulator dev ONLY, copy secrets to functions/.env.local — never
# functions/.env, or Cloud Run rejects the deploy: "Secret environment variable
# overlaps non secret environment variable".