rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Card images: publicly readable (displayed on card pages).
    // SVG is blocked — publicly served SVGs can carry scripts.
    match /users/{uid}/cards/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && !request.resource.contentType.matches('image/svg.*');
    }
    // Custom fonts: publicly readable so they render on shared cards
    match /users/{uid}/fonts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 6 * 1024 * 1024
        && (request.resource.contentType.matches('font/.*')
            || request.resource.contentType.matches('application/font-.*'));
    }
    // Other user content: owner-only read/write. SVG blocked (script risk).
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 6 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('font/.*')
            || request.resource.contentType.matches('application/font-.*'))
        && !request.resource.contentType.matches('image/svg.*');
    }
  }
}
